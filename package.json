{
  "name": "adobe-to-mixpanel",
  "version": "1.0.0",
  "description": "ETL from adbobe omniture to mixpanel",
  "main": "function.js",
  "scripts": {
    "dev": "npm run prune && NODE_ENV=dev nodemon --ignore tmp/ --ignore fake/ --ignore sampleData/ --inspect scratch.mjs | bunyan -o short",
    "local": "./scripts/local.sh",
    "deploy": "./scripts/deploy.sh",
    "test": "./scripts/test.sh",
    "prune": "rm -rf ./tmp/*",
    "buildReq": "nodemon --ignore tmp/ request-builder.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ak--47/adobeToMixpanel.git"
  },
  "type": "module",
  "author": "AK",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ak--47/adobeToMixpanel/issues"
  },
  "homepage": "https://github.com/ak--47/adobeToMixpanel#readme",
  "devDependencies": {
    "nodemon": "^2.0.19"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.2.0",
    "@google-cloud/logging-bunyan": "^4.2.2",
    "@google-cloud/storage": "^6.11.0",
    "ak-sheets": "^1.0.3",
    "ak-tools": "1.0.44",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "md5": "2.3.0",
    "node-gzip": "1.1.2",
    "papaparse": "5.3.2",
    "pino-pretty": "^13.0.0"
  }
}
