{
	// Adobe to Mixpanel ETL - VS Code Launch Configurations
	// Use IntelliSense to learn about possible attributes.
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "🚀 Deploy",
			"command": "npm run deploy",			
		},
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "🏠 Local",
			"command": "npm run local",
			"env": {
				"NODE_ENV": "dev"
			}
		},
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "🧪 Test",
			"command": "npm run test",
			
		},
		{
			"type": "node",
			"request": "launch",
			"name": "🔧 Scratch",
			"runtimeExecutable": "nodemon",
			"program": "scratch.mjs",
			"restart": true,
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"env": {
				"NODE_ENV": "dev"
			},
			
		},
		{
			"type": "node",
			"request": "launch",
			"name": "📦 Build Req",
			"runtimeExecutable": "nodemon",
			"program": "request-builder.mjs",
			"restart": true,
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"env": {
				"NODE_ENV": "dev"
			},
			
		},
		{
			"type": "node-terminal",
			"request": "launch",
			"name": "🧹 Clean",
			"command": "npm run prune",
			
		},
		{
			"type": "node",
			"request": "launch",
			"name": "📁 CURRENT",
			"runtimeExecutable": "nodemon",
			"program": "${file}",
			"restart": true,
			"console": "integratedTerminal",
			"internalConsoleOptions": "neverOpen",
			"env": {
				"NODE_ENV": "dev"
			},
			
		}
	]
}